---
import LandingLayout from '@/components/layout/LandingLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import TrustStrip from '@/components/sections/TrustStrip.astro'
import ValueProps from '@/components/sections/ValueProps.astro'
import Services from '@/components/sections/Services.astro'
import Process from '@/components/sections/Process.astro'
import BeforeAfterGallery from '@/components/sections/BeforeAfterGallery.astro'
import VideoWalkthrough from '@/components/sections/VideoWalkthrough.astro'
import WhyBoldCoat from '@/components/sections/WhyBoldCoat.astro'
import Testimonials from '@/components/sections/Testimonials.astro'
import ServiceArea from '@/components/sections/ServiceArea.astro'
import FAQ from '@/components/sections/FAQ.astro'
import FinalCta from '@/components/sections/FinalCta.astro'
import LandingFooter from '@/components/sections/LandingFooter.astro'
import LeadForm from '@/components/form/LeadForm.tsx'
import { interiorPageContent } from '@/content/pages/interior'
import { buildBreadcrumbSchema, buildServiceSchema, buildFAQSchema } from '@/lib/schema'
import { siteConfig } from '@/config/site'

const content = interiorPageContent

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: siteConfig.url },
    { name: 'Interior Painting Quote', url: `${siteConfig.url}/interior-quote/` },
  ]),
  buildServiceSchema({
    name: 'Interior Painting',
    description: content.meta.description,
    url: `${siteConfig.url}/interior-quote/`,
    image: `${siteConfig.url}${content.hero.image}`,
  }),
  buildFAQSchema(content.faq.items.map((item) => ({ question: item.question, answer: item.answer }))),
]
---

<LandingLayout
  title={content.meta.title}
  description={content.meta.description}
  canonical={content.meta.canonical}
  noindex={true}
  ogImage={content.meta.ogImage}
  schemas={schemas}
>
  <Hero content={content.hero} trustItems={content.trustStrip.items} />
  <TrustStrip content={content.trustStrip} />
  <ValueProps content={content.valueProps} />
  <Services content={content.services} />
  <Process content={content.process} />
  <BeforeAfterGallery content={content.beforeAfter} />
  <VideoWalkthrough content={content.videoWalkthrough} />
  <WhyBoldCoat content={content.whyBoldCoat} />
  <Testimonials content={content.testimonials} />
  <ServiceArea content={content.serviceArea} />
  <FAQ content={content.faq} />
  <FinalCta content={content.finalCta} formId="interior-quote" />
  <LandingFooter />
</LandingLayout>

<script>
  import LeadForm from '@/components/form/LeadForm.tsx'
  import { createElement } from 'react'
  import { createRoot } from 'react-dom/client'

  const mountEl = document.getElementById('lead-form-mount')
  if (mountEl) {
    const formId = mountEl.dataset.formId || 'interior-quote'
    const root = createRoot(mountEl)
    root.render(createElement(LeadForm, { formId }))
  }
</script>

<script>
  // Track CTA clicks
  document.querySelectorAll('[data-track-label]').forEach((el) => {
    el.addEventListener('click', () => {
      const label = (el as HTMLElement).dataset.trackLabel || ''
      const location = (el as HTMLElement).dataset.trackLocation || ''
      window.dataLayer = window.dataLayer || []
      window.dataLayer.push({ event: 'cta_click', cta_label: label, cta_location: location })
    })
  })
</script>

