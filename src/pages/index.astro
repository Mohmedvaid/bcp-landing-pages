---
import MarketingLayout from '@/components/layout/MarketingLayout.astro'
import Container from '@/components/ui/Container.astro'
import Button from '@/components/ui/Button.astro'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import { siteConfig } from '@/config/site'
import { routes } from '@/config/routes'
---

<MarketingLayout title="Home" description={siteConfig.description}>
  <section class="py-24">
    <Container>
      <div class="text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-accent-500">
          Phase 1 Placeholder
        </p>
        <h1 class="font-heading text-4xl font-bold text-neutral-900 sm:text-5xl">
          {siteConfig.name}
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-600">
          {siteConfig.description}
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href={routes.quote.interior.path} size="lg">Get a Free Quote</Button>
          <Button href={routes.services.index.path} variant="secondary" size="lg">
            Our Services
          </Button>
        </div>
        <div class="mt-6">
          <PhoneLink />
        </div>
      </div>
    </Container>
  </section>
</MarketingLayout>
