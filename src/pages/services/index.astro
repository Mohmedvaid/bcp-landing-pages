---
import MarketingLayout from '@/components/layout/MarketingLayout.astro'
import Container from '@/components/ui/Container.astro'
import Button from '@/components/ui/Button.astro'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import { siteConfig } from '@/config/site'
import { routes } from '@/config/routes'
import { buildBreadcrumbSchema } from '@/lib/schema'
import { buildCanonical } from '@/lib/seo'

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: buildCanonical('/') },
  { name: 'Services', url: buildCanonical('/services/') },
])

const services = [
  { route: routes.services.interior, desc: 'Premium interior painting for homes and rooms.' },
  {
    route: routes.services.exterior,
    desc: 'Full exterior repaints with Chicago-climate prep.',
  },
  { route: routes.services.cabinets, desc: 'Sprayed cabinet refinishing with premium finishes.' },
]
---

<MarketingLayout
  title="Services"
  description={`Painting services from ${siteConfig.name}: interior painting, exterior painting, and cabinet refinishing for Chicago and the North Shore.`}
  schemas={[breadcrumbs]}
>
  <section class="py-24">
    <Container>
      <div class="text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-accent-500">
          Phase 1 Placeholder
        </p>
        <h1 class="font-heading text-4xl font-bold text-neutral-900">Our Services</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-600">
          Full service pages with detailed content coming in Phase 3.
        </p>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {
          services.map((s) => (
            <div class="rounded-lg border border-neutral-200 p-6 text-center">
              <h2 class="font-heading text-xl font-bold text-neutral-900">{s.route.label}</h2>
              <p class="mt-2 text-sm text-neutral-600">{s.desc}</p>
              <div class="mt-4">
                <Button href={s.route.path} size="sm">
                  Learn More
                </Button>
              </div>
            </div>
          ))
        }
      </div>
      <div class="mt-8 text-center">
        <PhoneLink />
      </div>
    </Container>
  </section>
</MarketingLayout>
