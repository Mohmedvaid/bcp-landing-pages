---
import MarketingLayout from '@/components/layout/MarketingLayout.astro'
import Container from '@/components/ui/Container.astro'
import Button from '@/components/ui/Button.astro'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import { siteConfig } from '@/config/site'
import { routes } from '@/config/routes'
import { buildBreadcrumbSchema, buildServiceSchema } from '@/lib/schema'
import { buildCanonical } from '@/lib/seo'

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: buildCanonical('/') },
  { name: 'Services', url: buildCanonical('/services/') },
  { name: 'Cabinet Painting', url: buildCanonical('/services/cabinet-painting/') },
])

const serviceSchema = buildServiceSchema({
  name: 'Cabinet Painting & Refinishing',
  description:
    'Sprayed cabinet refinishing using Sherwin-Williams Emerald Urethane and Benjamin Moore Advance for homes in Chicago and the North Shore.',
  url: buildCanonical('/services/cabinet-painting/'),
})
---

<MarketingLayout
  title="Cabinet Painting & Refinishing"
  description={`Cabinet painting and refinishing from ${siteConfig.name}. Sprayed finishes with premium products for kitchens in Chicago and the North Shore.`}
  schemas={[breadcrumbs, serviceSchema]}
>
  <section class="py-24">
    <Container>
      <div class="text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-accent-500">
          Phase 1 Placeholder
        </p>
        <h1 class="font-heading text-4xl font-bold text-neutral-900">
          Cabinet Painting & Refinishing
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-600">
          Full service page content coming in Phase 3. Will include process details, pricing
          guidance, gallery, and FAQs.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href={routes.quote.cabinets.path}>Get Cabinet Quote</Button>
          <PhoneLink />
        </div>
      </div>
    </Container>
  </section>
</MarketingLayout>
