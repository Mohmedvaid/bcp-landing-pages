---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
  class?: string
}

const { size = 'lg', class: className = '' } = Astro.props

const maxWidths = {
  sm: 'max-w-screen-sm',
  md: 'max-w-screen-md',
  lg: 'max-w-screen-lg',
  xl: 'max-w-screen-xl',
  full: 'max-w-full',
}

const classes = ['mx-auto w-full px-4 sm:px-6 lg:px-8', maxWidths[size], className].join(' ')
---

<div class={classes}>
  <slot />
</div>
