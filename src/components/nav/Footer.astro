---
import { siteConfig } from '@/config/site'
import { footerNav } from '@/config/nav'
import PhoneLink from '@/components/ui/PhoneLink.astro'
---

<footer class="border-t border-neutral-200 bg-neutral-900 py-12 text-neutral-300">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-lg font-bold text-white">{siteConfig.name}</p>
      <p class="mt-2 text-sm">{siteConfig.shortDescription}</p>
      <div class="mt-4 space-y-1 text-sm">
        <PhoneLink class="text-neutral-300 hover:text-white" />
        <p>
          <a href={`mailto:${siteConfig.email}`} class="hover:text-white">
            {siteConfig.email}
          </a>
        </p>
      </div>
    </div>

    <div>
      <p class="font-semibold text-white">Services</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          footerNav.services.map((item) => (
            <li>
              <a href={item.path} class="hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white">Company</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          footerNav.company.map((item) => (
            <li>
              <a href={item.path} class="hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white">Contact</p>
      <address class="mt-3 space-y-1 text-sm not-italic">
        <p>{siteConfig.address.street}</p>
        <p>
          {siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}
        </p>
      </address>
    </div>
  </div>

  <div class="mx-auto mt-8 max-w-7xl border-t border-neutral-700 px-4 pt-6 text-center text-xs">
    <p>&copy; {new Date().getFullYear()} {siteConfig.legalName}. All rights reserved.</p>
  </div>
</footer>
