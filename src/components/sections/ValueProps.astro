---
import Container from '@/components/ui/Container.astro'
import type { ValuePropsContent } from '@/types/page-content'

interface Props {
  content: ValuePropsContent
}

const { content } = Astro.props
---

<section class="bg-white py-section-sm lg:py-section" aria-labelledby="value-props-heading">
  <Container size="lg">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent-500">
        {content.eyebrow}
      </p>
      <h2 id="value-props-heading" class="font-heading text-display-sm font-bold text-primary-800 lg:text-display-md">
        {content.heading}
      </h2>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {content.items.map((item) => (
        <div class="rounded-xl border border-neutral-100 bg-white p-6 shadow-soft transition-shadow hover:shadow-card">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-accent-50">
            <svg class="h-5 w-5 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              {item.iconName === 'paintbrush' && <path stroke-linecap="round" stroke-linejoin="round" d="M20.71 4.04a3.5 3.5 0 00-4.95 0L4.93 14.87a2.5 2.5 0 00-.64 1.09l-1.22 4.29a.5.5 0 00.61.61l4.29-1.22a2.5 2.5 0 001.09-.64L19.89 8.17" />}
              {item.iconName === 'ruler' && <path stroke-linecap="round" stroke-linejoin="round" d="M6 2L2 6l16 16 4-4L6 2zm4 4l2 2m-2 2l2 2m-2 2l2 2" />}
              {item.iconName === 'shield-check' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />}
              {item.iconName === 'headset' && <path stroke-linecap="round" stroke-linejoin="round" d="M3 18v-6a9 9 0 0118 0v6M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z" />}
            </svg>
          </div>
          <h3 class="mb-2 font-heading text-lg font-semibold text-primary-800">{item.title}</h3>
          <p class="text-body-sm text-neutral-600">{item.description}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
