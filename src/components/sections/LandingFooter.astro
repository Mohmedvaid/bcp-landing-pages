---
import Container from '@/components/ui/Container.astro'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import { siteConfig } from '@/config/site'
---

<footer class="bg-primary-900 py-12" aria-label="Footer">
  <Container size="lg">
    <div class="grid gap-8 md:grid-cols-3">
      <!-- Brand -->
      <div>
        <p class="font-heading text-lg font-bold text-white">{siteConfig.name}</p>
        <p class="mt-2 text-body-sm text-neutral-400">{siteConfig.shortDescription}</p>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Contact</h4>
        <div class="mt-3 space-y-2 text-body-sm text-neutral-300">
          <PhoneLink class="text-neutral-300 hover:text-accent-400" />
          <p>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-accent-400">
              {siteConfig.email}
            </a>
          </p>
          <p>{siteConfig.address.street}</p>
          <p>{siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}</p>
        </div>
      </div>

      <!-- Trust -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Credentials</h4>
        <ul class="mt-3 space-y-2 text-body-sm text-neutral-300">
          {siteConfig.certifications.map((cert) => (
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {cert.label}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <hr class="my-8 border-primary-700" />

    <p class="text-center text-sm text-neutral-500">
      &copy; {new Date().getFullYear()} {siteConfig.legalName}. All rights reserved.
    </p>
  </Container>
</footer>
