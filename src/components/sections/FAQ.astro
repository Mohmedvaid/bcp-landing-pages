---
import Container from '@/components/ui/Container.astro'
import type { FAQContent } from '@/types/page-content'

interface Props {
  content: FAQContent
}

const { content } = Astro.props
---

<section class="bg-neutral-50 py-section-sm lg:py-section" aria-labelledby="faq-heading">
  <Container size="md">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent-500">
        {content.eyebrow}
      </p>
      <h2 id="faq-heading" class="font-heading text-display-sm font-bold text-primary-800 lg:text-display-md">
        {content.heading}
      </h2>
    </div>

    <div class="mx-auto mt-10 max-w-3xl divide-y divide-neutral-200">
      {content.items.map((item, idx) => (
        <details class="group" data-faq-item data-question={item.question}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 text-left text-body font-medium text-primary-800 hover:text-primary-700">
            <span>{item.question}</span>
            <span class="shrink-0 text-neutral-400 transition-transform group-open:rotate-45">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
            </span>
          </summary>
          <div class="pb-5 pr-12 text-body-sm text-neutral-600">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>

<script>
  document.querySelectorAll('[data-faq-item]').forEach((item) => {
    item.addEventListener('toggle', (e) => {
      const details = e.target as HTMLDetailsElement
      if (details.open) {
        const question = details.getAttribute('data-question') || ''
        window.dataLayer = window.dataLayer || []
        window.dataLayer.push({ event: 'faq_open', faq_question: question })
      }
    })
  })
</script>
