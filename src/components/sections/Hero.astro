---
import Container from '@/components/ui/Container.astro'
import Button from '@/components/ui/Button.astro'
import type { HeroContent, TrustStripItem } from '@/types/page-content'
import { siteConfig } from '@/config/site'

interface Props {
  content: HeroContent
  trustItems: TrustStripItem[]
}

const { content, trustItems } = Astro.props
---

<section class="bg-neutral-50 py-16 lg:py-24" aria-labelledby="hero-heading">
  <Container size="xl">
    <div class="grid items-center gap-12 lg:grid-cols-5 lg:gap-16">
      <!-- Text Column (3/5) -->
      <div class="lg:col-span-3">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent-500">
          {content.eyebrow}
        </p>
        <h1
          id="hero-heading"
          class="font-heading text-display-md font-bold text-primary-800 lg:text-display-xl"
        >
          {content.headline}
        </h1>
        <p class="mt-5 text-body-lg text-neutral-600 lg:text-body-xl">
          {content.subhead}
        </p>

        <!-- Inline trust micro-strip -->
        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-neutral-500">
          {trustItems.map((item) => (
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                {item.iconName === 'star' && <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />}
                {item.iconName === 'shield-check' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />}
                {item.iconName === 'badge-check' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />}
                {item.iconName === 'calendar' && <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />}
              </svg>
              <span>{item.sourcePath === 'trust.googleRating' ? `${siteConfig.trust.googleRating} on Google` : item.sourcePath === 'trust.yearsInBusiness' ? `${siteConfig.trust.yearsInBusiness}+ Years Serving Chicagoland` : item.label}</span>
            </span>
          ))}
        </div>

        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <Button
            variant="primary"
            size="lg"
            href={content.ctaPrimary.href}
            data-track-label="get_free_quote"
            data-track-location="hero"
          >
            {content.ctaPrimary.label}
          </Button>
          <span class="text-sm text-neutral-500">{content.ctaSecondaryNote}</span>
        </div>
      </div>

      <!-- Image Column (2/5) -->
      <div class="lg:col-span-2">
        <img
          src={content.image}
          alt={content.imageAlt}
          width="640"
          height="480"
          class="w-full rounded-xl object-cover shadow-lifted"
          loading="eager"
        />
      </div>
    </div>
  </Container>
</section>
