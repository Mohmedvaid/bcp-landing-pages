---
import Container from '@/components/ui/Container.astro'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import type { FinalCtaContent } from '@/types/page-content'
import { siteConfig } from '@/config/site'

interface Props {
  content: FinalCtaContent
  formId: string
}

const { content, formId } = Astro.props
---

<section id="quote-form" class="bg-primary-800 py-section-sm lg:py-section" aria-labelledby="final-cta-heading">
  <Container size="lg">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Text column -->
      <div class="text-white">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent-400">
          {content.eyebrow}
        </p>
        <h2 id="final-cta-heading" class="font-heading text-display-sm font-bold text-white lg:text-display-md">
          {content.heading}
        </h2>
        <p class="mt-4 text-body-lg text-neutral-300">{content.subhead}</p>

        <!-- Trust row -->
        <div class="mt-8 flex flex-wrap items-center gap-4 text-sm text-neutral-300">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            EPA Lead-Safe Certified
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
            Licensed & Insured
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
            {siteConfig.trust.googleRating} Google Rating
          </span>
        </div>

        <!-- Phone CTA -->
        <div class="mt-8">
          <p class="text-sm text-neutral-400">Prefer to talk?</p>
          <PhoneLink class="mt-1 text-lg font-semibold text-white hover:text-accent-400" />
        </div>
      </div>

      <!-- Form card -->
      <div class="rounded-xl bg-white p-6 shadow-lifted lg:p-8">
        <h3 class="mb-5 font-heading text-xl font-bold text-primary-800">{content.formHeading}</h3>
        <div id="lead-form-mount" data-form-id={formId}></div>
      </div>
    </div>
  </Container>
</section>
