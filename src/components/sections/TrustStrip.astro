---
import Container from '@/components/ui/Container.astro'
import type { TrustStripContent } from '@/types/page-content'
import { siteConfig } from '@/config/site'

interface Props {
  content: TrustStripContent
}

const { content } = Astro.props

function getLabel(item: { label: string; sourcePath?: string }) {
  if (item.sourcePath === 'trust.googleRating') {
    return `${siteConfig.trust.googleRating} on Google`
  }
  if (item.sourcePath === 'trust.yearsInBusiness') {
    return `${siteConfig.trust.yearsInBusiness}+ Years Serving Chicagoland`
  }
  return item.label
}
---

<section class="border-y border-neutral-200 bg-white py-8 lg:py-12" aria-label="Trust indicators">
  <Container size="lg">
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
      {content.items.map((item) => (
        <div class="flex flex-col items-center gap-2 text-center">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-50">
            <svg class="h-5 w-5 text-primary-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              {item.iconName === 'star' && <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />}
              {item.iconName === 'shield-check' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />}
              {item.iconName === 'badge-check' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />}
              {item.iconName === 'calendar' && <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />}
            </svg>
          </div>
          <span class="text-sm font-medium text-primary-800">{getLabel(item)}</span>
        </div>
      ))}
    </div>
  </Container>
</section>
