---
import BaseLayout from './BaseLayout.astro'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import { siteConfig } from '@/config/site'

interface Props {
  title: string
  description: string
  canonical?: string
  noindex?: boolean
  ogImage?: string
  ogType?: string
  schemas?: object[]
}

const { title, description, canonical, noindex, ogImage, ogType, schemas } = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  ogImage={ogImage}
  ogType={ogType}
  schemas={schemas}
>
  <!-- Skip to content -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent-400 focus:px-4 focus:py-2 focus:text-primary-800 focus:shadow-lg"
  >
    Skip to main content
  </a>

  <header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/95 backdrop-blur-sm">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 lg:h-[72px]">
      <a href="/" class="font-heading text-lg font-bold text-primary-800" aria-label="Bold Coat Painters Home">
        {siteConfig.name}
      </a>
      <div class="flex items-center gap-4">
        <PhoneLink class="text-sm" />
        <a
          href="#quote-form"
          class="hidden rounded-md bg-accent-400 px-4 py-2 text-sm font-semibold text-primary-800 transition-colors hover:bg-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2 sm:inline-flex"
          data-track-label="get_free_estimate"
          data-track-location="header"
        >
          Get Free Estimate
        </a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>
</BaseLayout>

