---
import BaseLayout from './BaseLayout.astro'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import { siteConfig } from '@/config/site'

interface Props {
  title: string
  description: string
  canonical?: string
  noindex?: boolean
  ogImage?: string
  ogType?: string
  schemas?: object[]
}

const { title, description, canonical, noindex, ogImage, ogType, schemas } = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  ogImage={ogImage}
  ogType={ogType}
  schemas={schemas}
>
  <header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/95 backdrop-blur-sm">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
      <a href="/" class="text-lg font-bold text-primary-800" aria-label="Bold Coat Painters Home">
        {siteConfig.name}
      </a>
      <div class="flex items-center gap-4">
        <PhoneLink class="hidden sm:inline-flex" />
        <a
          href="#quote-form"
          class="rounded-md bg-accent-400 px-4 py-2 text-sm font-semibold text-primary-800 transition-colors hover:bg-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2"
        >
          Get Free Quote
        </a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <footer class="border-t border-neutral-200 bg-neutral-50 py-8">
    <div class="mx-auto max-w-7xl px-4 text-center text-sm text-neutral-600">
      <p>{siteConfig.name} &bull; {siteConfig.address.city}, {siteConfig.address.state}</p>
      <p class="mt-1">
        <PhoneLink /> &bull;
        <a href={`mailto:${siteConfig.email}`} class="underline hover:text-accent-400">
          {siteConfig.email}
        </a>
      </p>
    </div>
  </footer>
</BaseLayout>
