---
import BaseLayout from './BaseLayout.astro'
import Header from '@/components/nav/Header.astro'
import Footer from '@/components/nav/Footer.astro'

interface Props {
  title: string
  description: string
  canonical?: string
  noindex?: boolean
  ogImage?: string
  ogType?: string
  schemas?: object[]
}

const { title, description, canonical, noindex, ogImage, ogType, schemas } = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  ogImage={ogImage}
  ogType={ogType}
  schemas={schemas}
>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</BaseLayout>
